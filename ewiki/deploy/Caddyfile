# ewiki 网关（ENGINEERING 第 5.3 / SDD ADR-6/13）
# 双发布地址形态（PRD R4）：子域名 {slug}.ewiki.yfzx.cn + 子路径 ewiki.yfzx.cn/wiki/{slug}
{
    on_demand_tls {
        ask http://server:3000/api/v1/open/site-check
    }
}

# ---- 主站：SPA + API + 实时 ----
ewiki.yfzx.cn {
    handle /api/* {
        reverse_proxy server:3000
    }
    handle /ws {
        reverse_proxy realtime:3001
    }
    handle /collab* {
        reverse_proxy realtime:3001
    }
    # 子路径形态：/wiki/{slug}/* → S3 上 {slug}/current 产物
    handle_path /wiki/{slug}/* {
        rewrite * /{slug}/current{path}
        reverse_proxy minio:9000
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

# ---- 子域名形态：{slug}.ewiki.yfzx.cn → S3 产物 ----
*.ewiki.yfzx.cn {
    tls {
        on_demand
    }
    @slug header_regexp Host Host ^(?<sub>[a-z0-9-]+)\.ewiki\.yfzx\.cn$
    handle {
        rewrite * /sites/{sub}/current{path}
        reverse_proxy minio:9000
    }
}
