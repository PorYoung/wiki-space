# ============================================================
# ewiki 生产/内网部署环境模板
# 用法：cp deploy/.env.production.example deploy/.env.production
#       修改密码与密钥后：
#       docker compose --env-file deploy/.env.production -f deploy/compose.yml up -d
#
# 本文件同时承担两个职责：
#   A) compose 变量插值（--env-file）：TAG / POSTGRES_PASSWORD / MINIO_* / NAS_HOST_ROOT / PLATFORM_DATA_HOST_ROOT
#   B) 容器内进程环境（env_file）：其余全部变量
# .env.production 已被 .gitignore 忽略，不会入库。
# ============================================================

# ---- A. compose 插值 ----
# 应用镜像标签：连接侧 airgap-export.sh 默认用 git 短 SHA；离线导入后保持一致即可
TAG=latest
POSTGRES_PASSWORD=change-me-strong
MINIO_ROOT_USER=ewiki
MINIO_ROOT_PASSWORD=change-me-strong
# 宿主机 NAS 目录（compose 卷挂载的宿主侧路径；容器内固定挂到 /srv/nas/wiki 与 /srv/platform/data）
NAS_HOST_ROOT=/srv/nas/wiki
PLATFORM_DATA_HOST_ROOT=/srv/nas/wiki-platform

# ---- 服务 ----
PORT_SERVER=3000
PORT_REALTIME=3001
LOG_LEVEL=info

# ---- 数据库（容器网络内：主机名=postgres） ----
DATABASE_URL=postgres://ewiki:change-me-strong@postgres:5432/ewiki

# ---- 认证（上线前必改；≥16 字符随机串） ----
JWT_SECRET=change-me-32-bytes-min-random

# ---- 存储（ADR-12：S3 主 + NAS 回退；容器拓扑挂载宿主机 NAS 目录） ----
# 容器内路径（对应 compose 卷挂载），server 与 worker 必须一致
FS_ROOT=/srv/platform/data
FS_NAS_ROOT=/srv/nas/wiki
STORAGE_DRIVER=fs
NAS_FALLBACK_ENABLED=false
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ewiki
S3_ACCESS_KEY=ewiki
S3_SECRET_KEY=change-me-strong

# ---- 二进制上传（P2：内容寻址 blob + 短期签名 raw URL） ----
UPLOAD_MAX_BYTES=104857600
BLOB_DRIVER=local
BLOB_LOCAL_ROOT=
RAW_URL_TTL_SECONDS=1800

# ---- 发布双地址（PRD R4）；网关域名与 Caddyfile 保持一致 ----
EWIKI_BASE_DOMAIN=ewiki.yfzx.cn
SITE_ADDRESS_MODE=subdomain

# ---- 存储源连接凭据加密（32 字节 hex/base64，server/worker 必须一致；上线前必改） ----
ENCRYPTION_KEY=change-me-32-bytes-hex-0000000000000

# ---- AI 适配器（可选） ----
LLM_PROVIDER=
LLM_API_KEY=

# ---- 检索（SEARCH-VECTOR-DESIGN §9.1；server 与 worker 共享）----
# 中文分词由检索镜像 ewiki/pg16-search（pgvector + zhparser）提供；缺席时自动降级 simple
SEARCH_FTS_CONFIG=chinese_zh
SEARCH_SEMANTIC_MIN_SCORE=0.3
SEARCH_INDEX_DEBOUNCE_SECONDS=30
# 嵌入 Provider：none（默认，向量检索整体下线）| openai-compatible
# 内网气隙运行：指向内网 Ollama（/v1 兼容），如 http://<ollama-host>:11434/v1
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# 维度首次启用向量后不可变（pgvector 列 vector(1024) 固定）；必须与模型输出维度一致
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=10000

# ---- 开放 API / MCP（OPEN-API-MCP-DESIGN §10） ----
# 进程级总开关：false 时 /api/open/v1/* 全部 404（不对外开放时使用）
OPENAPI_ENABLED=true
OPENAPI_PUBLIC_SEARCH=false
# 内网收紧示例：OPENAPI_CORS_ORIGINS=http://ewiki.yfzx.cn
OPENAPI_CORS_ORIGINS=*
