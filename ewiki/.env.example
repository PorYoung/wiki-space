# ---- 服务 ----
PORT_SERVER=3000
PORT_REALTIME=3001
LOG_LEVEL=info

# ---- 数据库（唯一有状态设施） ----
DATABASE_URL=postgres://ewiki:ewiki@localhost:5432/ewiki

# ---- 认证 ----
JWT_SECRET=change-me-32-bytes-min
REFRESH_TTL_DAYS=7

# ---- 存储（ADR-12：S3 主 + NAS 回退） ----
STORAGE_DRIVER=fs
FS_ROOT=./data
FS_NAS_ROOT=./data-nas
NAS_FALLBACK_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ewiki
S3_ACCESS_KEY=ewiki
S3_SECRET_KEY=ewiki-secret

# ---- 二进制上传（P2：内容寻址 blob + 短期签名 raw URL） ----
UPLOAD_MAX_BYTES=104857600
BLOB_DRIVER=local
# 留空时取 path.join(FS_NAS_ROOT, 'blobs')
BLOB_LOCAL_ROOT=
RAW_URL_TTL_SECONDS=1800

# ---- 发布双地址（PRD R4） ----
EWIKI_BASE_DOMAIN=ewiki.yfzx.cn
SITE_ADDRESS_MODE=subdomain

# ---- 存储源连接凭据加密（storage_connections 令牌 AES-256-GCM 主密钥，32 字节 hex/base64） ----
ENCRYPTION_KEY=change-me-32-bytes-hex-0000000000000

# ---- AI 适配器（可选） ----
LLM_PROVIDER=
LLM_API_KEY=

# ---- 检索（SEARCH-VECTOR-DESIGN §9.1；server 与 worker 共享）----
# 全文分词配置：chinese_zh 由迁移 0008 保证存在（zhparser 缺席时自动降级为 simple 拷贝）
SEARCH_FTS_CONFIG=chinese_zh
# 语义相似度阈值（cosine，低于该值的 chunk 不进入结果）
SEARCH_SEMANTIC_MIN_SCORE=0.3
# 索引防抖窗口（秒）：窗口内同文档重复保存合并为一次索引任务
SEARCH_INDEX_DEBOUNCE_SECONDS=30
# 嵌入 Provider：none（默认，向量检索整体下线）| openai-compatible
#   openai-compatible 兼容 OpenAI/智谱/通义/Ollama(/v1)/vLLM；内网部署指向 Ollama 即可气隙运行
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
# EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# 维度首次启用向量后不可变（pgvector 列 vector(1024) 固定）；必须与模型输出维度一致
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=10000

# ---- 平台化扩展（2026-09 首期） ----
WEB_DIST=../web/dist
# FS_NAS_ROOT=/srv/nas/wiki  # server 与 worker 必须指向同一绝对路径

# ---- 开放 API / MCP（OPEN-API-MCP-DESIGN §10） ----
# 进程级总开关：false 时 /api/open/v1/* 全部 404（气隙/不对外开放时使用）
OPENAPI_ENABLED=true
# 公开检索强制抬升：true 时无视管理端 KV 配置强制开启 D1 公开检索（默认跟随管理端配置，缺省关）
OPENAPI_PUBLIC_SEARCH=false
# 开放面 CORS 允许来源：'*' 反射任意 Origin（token/匿名鉴权，无 cookie；默认）；逗号分隔白名单可收紧
OPENAPI_CORS_ORIGINS=*
